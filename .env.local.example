# Copy to .env.local and restart: npm run dev

# ─── SUPABASE (Database + Auth) ───
# Dashboard: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only (API routes, order updates) — never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── STORAGE ───
# Run supabase/storage.sql in Supabase SQL Editor to create buckets:
#   product-images  — product photos (CDN)
#   site-assets     — logo, hero, lookbook images

# Admin emails (comma-separated)
NEXT_PUBLIC_ADMIN_EMAILS=abcdef@gmail.com

# ─── RAZORPAY (optional — COD works without this) ───
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx
# RAZORPAY_KEY_ID=rzp_test_xxxxx
# RAZORPAY_KEY_SECRET=your_secret_key
